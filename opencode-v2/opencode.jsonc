{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "references": {
    "effect": "github.com/Effect-TS/effect-smol",
    "epilot": "~/Developer/epilot-codebase"
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/Developer/epilot-codebase/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/?",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/Developer/?",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/Developer/code/?",
      "effect": "deny"
    }
  ]
}
