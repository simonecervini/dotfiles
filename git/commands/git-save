#!/bin/bash
repo_root=$(git rev-parse --show-toplevel) || exit 1

skip_ci=true
for arg in "$@"; do
    case "$arg" in
        --no-skip-ci) skip_ci=false ;;
    esac
done

current_branch=$(git -C "$repo_root" branch --show-current)
if [ -z "$current_branch" ]; then
    echo "Error: Cannot push save commit from detached HEAD"
    exit 1
fi

for branch in main master production prod; do
    if [ "$current_branch" = "$branch" ]; then
        echo "Error: Cannot push save commit to $current_branch (protected branch)"
        exit 1
    fi
done

git -C "$repo_root" add -A

name_status=$(git -C "$repo_root" diff --cached --name-status -M)
stat=$(git -C "$repo_root" diff --cached --stat -M)
timestamp=$(date '+%Y-%m-%d %H:%M:%S (%Z)')

added=0
modified=0
deleted=0
renamed=0
copied=0
typechanged=0
other=0
files=""

if [ -n "$name_status" ]; then
    while IFS=$'\t' read -r status path extra; do
        case "$status" in
            A) added=$((added + 1)) ;;
            M) modified=$((modified + 1)) ;;
            D) deleted=$((deleted + 1)) ;;
            R*) renamed=$((renamed + 1)) ;;
            C*) copied=$((copied + 1)) ;;
            T) typechanged=$((typechanged + 1)) ;;
            *) other=$((other + 1)) ;;
        esac

        if [ -n "$extra" ]; then
            files="${files}${status} ${path} -> ${extra}
"
        else
            files="${files}${status} ${path}
"
        fi
    done <<< "$name_status"
else
    files="(none)"
    stat="(none)"
fi

file_count=$((added + modified + deleted + renamed + copied + typechanged + other))
summary_parts=()
[ "$modified" -gt 0 ] && summary_parts+=("$modified modified")
[ "$added" -gt 0 ] && summary_parts+=("$added added")
[ "$deleted" -gt 0 ] && summary_parts+=("$deleted deleted")
[ "$renamed" -gt 0 ] && summary_parts+=("$renamed renamed")
[ "$copied" -gt 0 ] && summary_parts+=("$copied copied")
[ "$typechanged" -gt 0 ] && summary_parts+=("$typechanged type changed")
[ "$other" -gt 0 ] && summary_parts+=("$other other")

if [ "$file_count" -eq 0 ]; then
    subject="save(0): no changes"
else
    summary=""
    for part in "${summary_parts[@]}"; do
        if [ -z "$summary" ]; then
            summary="$part"
        else
            summary="$summary, $part"
        fi
    done
    subject="save(${file_count}): $summary"
fi

if [ "$skip_ci" = true ]; then
    commit_msg=$(printf '%s\n\nFiles:\n%s\n\nStats:\n%s\n\n[skip ci]\n\nT = %s' "$subject" "$files" "$stat" "$timestamp")
else
    commit_msg=$(printf '%s\n\nFiles:\n%s\n\nStats:\n%s\n\nT = %s' "$subject" "$files" "$stat" "$timestamp")
fi

git -C "$repo_root" commit -m "$commit_msg" --no-verify --allow-empty && git -C "$repo_root" push -u origin HEAD
